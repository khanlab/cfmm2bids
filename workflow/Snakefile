from pathlib import Path
from lib.query_filter import validate_column, query_dicoms, post_filter

configfile: 'config/config.yml'

# Load stages dict
stages = config.get("stages", {})

stage_query    = Path(stages.get("query", "results/0_query"))
stage_filter   = Path(stages.get("filter", "results/1_filter"))
stage_download = Path(stages.get("download", "results/2_download"))
stage_convert  = Path(stages.get("convert", "results/3_convert"))
stage_fix      = Path(stages.get("fix", "results/4_fix"))
stage_report   = Path(stages.get("report", "results/5_report"))

final_bids_dir = Path(config.get("final_bids_dir", "bids"))


# query
df = query_dicoms(config['search_specs'],
                  credentials_file=config['credentials_file'])

#save unfiltered list
stage_query.mkdir(parents=True,exist_ok=True)
df.to_csv(stage_query / 'studies.tsv',sep='\t',index=False)

# Validate both columns
valid_subject = validate_column(df, 'subject')
valid_session = validate_column(df, 'session')

# Optionally, check if all rows are valid overall
all_valid = valid_subject & valid_session
if all_valid.all():
    print("✅ All subject and session ids are valid!")
else:
    print("⚠️ Some rows have invalid entries:")
    print(df[['StudyDescription','PatientID','StudyDate','subject','session']][~all_valid])


df = post_filter(df,config['study_filter_specs'])


#use --config head=1  to only process first subject
head_n = config.get('head',0) 
if head_n > 0:
    df = df.head(head_n)


#write this out so user can inspect
stage_filter.mkdir(parents=True,exist_ok=True)
df.to_csv(stage_filter / 'studies_filtered.tsv', sep='\t', index=False)



rule all:
    input: 
        expand(
            final_bids_dir / 'sub-{subject}/ses-{session}',
            zip,
            subject=df.subject,
            session=df.session
        ),
        final_bids_dir / 'dataset_description.json',

rule head:
    """ run only on the first subject """
    input: 
        expand(
            final_bids_dir / 'sub-{subject}/ses-{session}',
            zip,
            subject=df.head(1).subject,
            session=df.head(1).session
        ),
        final_bids_dir / 'dataset_description.json',


rule download:
    input:
        expand(
            stage_download / 'dicoms/sub-{subject}/ses-{session}',
            zip,
            subject=df.subject,
            session=df.session
        )

rule convert:
    input:
        validator_json=stage_convert/'qc/bids_validator.json'

rule fix:
    input:
        validator_json=stage_fix/'qc/bids_validator.json'

rule report:
    input:
        expand(
            stage_report / 'sub-{subject}/ses-{session}/report.html',
            zip,
            subject=df.subject,
            session=df.session
        )


def get_uid_from_wildcards(wildcards):
    matches = lookup(
        query=f"subject == '{wildcards.subject}' and session == '{wildcards.session}'",
        within=df
    )
    if isinstance(matches, tuple):
        return matches.StudyInstanceUID
    else:
        ids = [m.StudyInstanceUID for m in matches]
        if config["merge_duplicates"]:
            print(f"WARNING: Merging multiple matches for {wildcards}")
        else:
            bad_ids = "\n".join(ids)
            raise LookupError(f'Multiple studies matched for {wildcards}: \n{bad_ids}\nThese can be merged instead by using setting in the config "merge_ducplicates: true" ')



rule cfmm2tar:
    params:
        uid=get_uid_from_wildcards,
        cfmm2tar_download_options=config['cfmm2tar_download_options'],
        creds_file=config['credentials_file']
    output:
        dicoms_dir=directory(stage_download / 'dicoms/sub-{subject}/ses-{session}')
    log:
        'logs/download/sub-{subject}_ses-{session}.log'
    threads: 1
    resources:
        mem_mb=4000,
        runtime=15
    shell:
        "cfmm2tar -c {params.creds_file} {params.cfmm2tar_download_options} -u {params.uid} {output.dicoms_dir} &> {log}"

rule heudiconv:
    input:
        dicoms_dir=rules.cfmm2tar.output.dicoms_dir,
        heuristic=config['heuristic'],
        dcmconfig_json=config['dcmconfig_json'],
    params: 
        heudiconv_options=config['heudiconv_options'],
        in_auto_txt=lambda wildcards: stage_convert /'bids/.heudiconv/{subject}/ses-{session}/info/{subject}_ses-{session}.auto.txt'.format(**wildcards),
        in_dicominfo_tsv=lambda wildcards: stage_convert / 'bids/.heudiconv/{subject}/ses-{session}/info/dicominfo_ses-{session}.tsv'.format(**wildcards),
        in_filegroup_json=lambda wildcards: stage_convert / 'bids/.heudiconv/{subject}/ses-{session}/info/filegroup_ses-{session}.json'.format(**wildcards),
        out_info_dir=lambda wildcards: stage_convert  / 'info/sub-{subject}/ses-{session}'.format(**wildcards),
        out_bids=stage_convert / 'bids'
    output:
        bids_subj_dir=directory(stage_convert / 'bids/sub-{subject}/ses-{session}'),
        auto_txt=stage_convert / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_auto.txt',
        dicominfo_tsv=stage_convert / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_dicominfo.tsv',
        filegroup_json=stage_convert / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_filegroup.json'
    log:
        'logs/heudiconv/sub-{subject}_ses-{session}.log'
    shadow: 'minimal'
    threads: 16
    resources: 
        mem_mb=8000,
        runtime=15
    group: 'convert'
    shell:
        (
            "heudiconv --files {input.dicoms_dir}"
            " -c dcm2niix"
            " -o {params.out_bids}"
            " -ss {wildcards.session}"
            " -s {wildcards.subject}"
            " -f {input.heuristic}"
            " --bids notop"
            " --dcmconfig {input.dcmconfig_json}"
            " --overwrite"
            " {params.heudiconv_options} &> {log}"
            " && mkdir -p {params.out_info_dir}"
            " && cp {params.in_auto_txt} {output.auto_txt}"
            " && cp {params.in_dicominfo_tsv} {output.dicominfo_tsv}"
            " && cp {params.in_filegroup_json} {output.filegroup_json}"
        )

rule init_dataset_description:
    input:
        'resources/dataset_description.json'
    output:
        stage_convert / 'bids/dataset_description.json'
    log:
        'logs/dataset_description/init_dataset_description.log'
    shell:
        'cp {input} {output} &> {log}'

rule generate_convert_qc_figs:
    input:
        auto_txt=rules.heudiconv.output.auto_txt,
        dicominfo_tsv=rules.heudiconv.output.dicominfo_tsv,
        filegroup_json=rules.heudiconv.output.filegroup_json,
    output:
        series_list=stage_convert / 'qc/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_series.svg',
        unmapped=stage_convert / 'qc/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_unmapped.svg'
    log:
        'logs/generate_convert_qc_figs/sub-{subject}_ses-{session}.log'
    threads: 1
    resources: 
        mem_mb=4000,
        runtime=10
    group: 'convert'
    script:
        'scripts/generate_convert_qc_figs.py'

rule validate_convert:
    input:
        dataset_description=stage_convert/'bids/dataset_description.json',
        qc_report_figs = expand(
            stage_fix / 'qc/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_series.svg',
            zip,
            subject=df.subject,
            session=df.session
        )

    params:
        bids_dir=stage_convert / 'bids'
    output:
        validator_json=stage_convert/'qc/bids_validator.json'
    threads: 1
    resources:
        mem_mb=4000,
        runtime=10
    log:
        'logs/convert/validator.txt'
    shell:
        # || true prevents workflow failure when validation errors are found
        # validate twice, to write to log, to txt, and to json
        'bids-validator-deno {params.bids_dir} --format text &> {log} && '   
        'bids-validator-deno {params.bids_dir} --format json_pp -o {output.validator_json} || true'


rule post_convert_fix:
    """
    Copy BIDS dataset and apply post-conversion fixes
    (defined in config['post_bids_fixes']) sequentially.
    """
    input:
        bids_subj_dir=stage_convert / 'bids/sub-{subject}/ses-{session}'
    output:
        bids_subj_dir=directory(stage_fix / 'bids/sub-{subject}/ses-{session}'),
        prov_json=stage_fix / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_provenance.json'
    params:
        fixes=config["post_convert_fixes"]
    log:
        'logs/post_convert_fix/sub-{subject}_ses-{session}.log'
    threads: 1
    resources:
        mem_mb=8000
    script:
        "scripts/post_convert_fix.py"


rule fix_dataset_description:
    input:
        'resources/dataset_description.json'
    output:
        stage_fix / 'bids/dataset_description.json'
    log:
        'logs/fix/dataset_description.log'
    shell:
        'cp {input} {output} &> {log}'


rule validate_fix:
    input:
        dataset_description=stage_fix/'bids/dataset_description.json',
        prov_jsons = expand(
            stage_fix / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_provenance.json',
            zip,
            subject=df.subject,
            session=df.session
        )
    params:
        bids_dir=stage_fix / 'bids'
    output:
        validator_json=stage_fix/'qc/bids_validator.json'
    threads: 1
    resources:
        mem_mb=4000,
        runtime=10
    log:
        'logs/fix/validator.txt'
    shell:
        # || true prevents workflow failure when validation errors are found
        # validate twice, to write to log, to txt, and to json
        'bids-validator-deno {params.bids_dir} --format text &> {log} && '   
        'bids-validator-deno {params.bids_dir} --format json_pp -o {output.validator_json}'


# Subject/session report generation
rule generate_subject_session_report:
    """
    Generate aggregated summary report for a subject/session.
    
    This rule aggregates information from all stages (convert, fix) and creates:
    1. Aggregated JSON with metadata
    2. Aggregated TSV with series information
    3. Datavzrd configuration file
    """
    input:
        auto_txt=stage_convert / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_auto.txt',
        dicominfo_tsv=stage_convert / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_dicominfo.tsv',
        filegroup_json=stage_convert / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_filegroup.json',
        prov_json=stage_fix / 'info/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_provenance.json'
    output:
        aggregated_json=stage_report / 'sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_summary.json',
        aggregated_tsv=stage_report / 'sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_summary.tsv',
        datavzrd_config=stage_report / 'sub-{subject}/ses-{session}/datavzrd_config.yaml'
    log:
        'logs/generate_subject_session_report/sub-{subject}_ses-{session}.log'
    threads: 1
    resources:
        mem_mb=4000,
        runtime=10
    script:
        'scripts/generate_subject_session_report.py'


rule render_subject_session_report:
    """
    Render the subject/session report as an interactive HTML using datavzrd.
    """
    input:
        aggregated_tsv=rules.generate_subject_session_report.output.aggregated_tsv,
        aggregated_json=rules.generate_subject_session_report.output.aggregated_json,
        datavzrd_config=rules.generate_subject_session_report.output.datavzrd_config
    output:
        html_report=stage_report / 'sub-{subject}/ses-{session}/report.html'
    params:
        report_dir=lambda wildcards: stage_report / f'sub-{wildcards.subject}/ses-{wildcards.session}'
    log:
        'logs/render_subject_session_report/sub-{subject}_ses-{session}.log'
    threads: 1
    resources:
        mem_mb=4000,
        runtime=10
    shell:
        "datavzrd {input.datavzrd_config} --output {params.report_dir}/datavzrd_output &> {log} && "
        "mv {params.report_dir}/datavzrd_output/index.html {output.html_report}"


# final_bids_dir
