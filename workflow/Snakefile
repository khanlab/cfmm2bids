from pathlib import Path

import pandas as pd

from lib.query_filter import (
    compute_query_hash,
    post_filter,
    query_dicoms,
    should_skip_query,
    validate_column,
)


configfile: "config/config.yml"


# Load stages dict
stages = config.get("stages", {})

stage_query = Path(stages.get("query", "results/0_query"))
stage_filter = Path(stages.get("filter", "results/1_filter"))
stage_download = Path(stages.get("download", "results/2_download"))
stage_convert = Path(stages.get("convert", "results/3_convert"))
stage_fix = Path(stages.get("fix", "results/4_fix"))
stage_gradcorr = Path(stages.get("gradcorr", "results/5_gradcorr"))

# Centralized download cache
download_cache = Path(config.get("download_cache", "results/download_cache"))

final_bids_dir = Path(config.get("final_bids_dir", "bids"))

# Gradient nonlinearity correction settings
gradcorrect_config = config.get("gradcorrect", {})
use_gradcorrect = gradcorrect_config.get("enable", False)

if use_gradcorrect and not gradcorrect_config.get("grad_coeff_file"):
    raise ValueError(
        "gradcorrect is enabled but 'gradcorrect.grad_coeff_file' is not set in config. "
        "Please provide the path to the gradient coefficient file."
    )

# Stage used for final assembly - gradcorr if enabled, otherwise fix
stage_for_assembly = stage_gradcorr if use_gradcorrect else stage_fix

# Uncorrected BIDS settings (only relevant when gradcorrect is enabled)
create_bids_uncorr = use_gradcorrect and gradcorrect_config.get(
    "create_bids_uncorr", False
)
final_bids_uncorr_dir = Path(config.get("final_bids_uncorr_dir", "bids_uncorr"))

# ----------
# 0 - query
# ----------
# Paths for query output and hash file
query_tsv_path = stage_query / "studies.tsv"
query_hash_path = stage_query / "query_hash.txt"

# Compute current hash of query parameters
current_query_hash = compute_query_hash(
    config["search_specs"], config.get("query_kwargs", {})
)

# Check if we can skip the query
force_requery = config.get("force_requery", False)
skip_query = should_skip_query(
    query_tsv_path, query_hash_path, current_query_hash, force_requery
)

if skip_query:
    # Try to load existing query results; fall back to re-querying on error
    try:
        df = pd.read_csv(
            query_tsv_path, sep="\t", dtype={"subject": str, "session": str}
        )
    except (pd.errors.ParserError, pd.errors.EmptyDataError, OSError):
        # Fall back to re-querying if cached file is corrupted or unreadable
        skip_query = False

if not skip_query:
    # Perform new query
    df = query_dicoms(
        config["search_specs"],
        credentials_file=config["credentials_file"],
        **config.get("query_kwargs", dict()),
    )

    # save unfiltered list and hash
    stage_query.mkdir(parents=True, exist_ok=True)
    df.to_csv(query_tsv_path, sep="\t", index=False)
    query_hash_path.write_text(current_query_hash)

# Validate both columns
valid_subject = validate_column(df, "subject")
valid_session = validate_column(df, "session")

# ----------
# 1 - filter
# ----------
df = post_filter(df, config["study_filter_specs"]).sort_values(
    by=["subject", "session"]
)


# use --config subject= to process particular subject
if config.get("subject", False):
    df = df[df.subject == str(config["subject"])]

# use --config subject= to process particular subject
if config.get("session", False):
    df = df[df.session == str(config["session"])]

# use --config head=1  to only process first subject
head_n = config.get("head", 0)
if head_n > 0:
    df = df.head(head_n)


# write this out so user can inspect
stage_filter.mkdir(parents=True, exist_ok=True)
df.to_csv(stage_filter / "studies_filtered.tsv", sep="\t", index=False)

# lists for target rules (duplicates dropped)
subjects = df[["subject", "session"]].drop_duplicates().subject
sessions = df[["subject", "session"]].drop_duplicates().session

# Get unique UIDs for download cache
unique_uids = df["StudyInstanceUID"].unique().tolist()

# Collect uncorrected BIDS targets when gradcorrect + create_bids_uncorr are both enabled
_bids_uncorr_targets = (
    [
        *expand(
            final_bids_uncorr_dir / "sub-{subject}/ses-{session}",
            zip,
            subject=subjects,
            session=sessions,
        ),
        final_bids_uncorr_dir / "dataset_description.json",
        final_bids_uncorr_dir / ".bidsignore",
    ]
    if create_bids_uncorr
    else []
)


# SPIM linkages

spim_targets = []
if "spim" in config and config.get("link_to_spim", False):

    import string as _string

    from snakebids import generate_inputs

    spim_targets = []

    for ses, cfg in config["spim"].items():
        # Validate out_path only uses {subject} and {session} wildcards,
        # since those are the only wildcards available in the link_spim rule.
        _allowed_wildcards = {"subject", "session"}
        _used_wildcards = {
            field_name
            for _, field_name, _, _ in _string.Formatter().parse(cfg["out_path"])
            if field_name is not None
        }
        _unknown = _used_wildcards - _allowed_wildcards
        if _unknown:
            raise ValueError(
                f"SPIM config for session '{ses}': out_path '{cfg['out_path']}' "
                f"contains unsupported wildcards: {_unknown}. "
                f"Only 'subject' and 'session' are available."
            )

        config["spim"][ses]["inputs"] = generate_inputs(
            bids_dir=cfg["bids_dir"], pybids_inputs=cfg["pybids_inputs"]
        )

        # get intersection of MRI subjects and SPIM subjects
        subjects_spim = config["spim"][ses]["inputs"].subjects
        subjects_spim_mri = set(subjects_spim) & set(subjects)
        subjects_spim_no_mri = set(subjects_spim) - subjects_spim_mri

        if len(subjects_spim_no_mri) > 0:
            print(
                f"WARNING: there are SPIM subjects that do not correspond to an MRI subject: {subjects_spim_no_mri}."
            )
            print(
                "  This could be expected of batch controls, but if not may indicate incorrect subject labels"
            )

        spim_targets.extend(
            expand(
                final_bids_dir / "sub-{subject}" / "ses-{session}",
                subject=list(subjects_spim_mri),
                session=ses,
            )
        )


