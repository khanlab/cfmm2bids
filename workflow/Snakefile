rule assemble_final_bids:
    """
    Assemble the final BIDS dataset by copying from the fixed BIDS directory.
    Now outputs individual session directories and top-level files as separate entities,
    allowing for incremental updates instead of regenerating the entire directory.
    Uses cp -RL to follow symlinks and copy actual files instead of broken symlinks.
    When gradcorrect is enabled, subject/session dirs are sourced from the gradcorr stage.
    """
    input:
        validator_txt=stage_for_assembly / "qc/final_bids_validator.txt",  # require validated
        bids_subj_dir=stage_for_assembly / "bids-staging/sub-{subject}/ses-{session}",
    output:
        bids_subj_dir=directory(final_bids_dir / "sub-{subject}/ses-{session}"),
    threads: 1
    resources:
        mem_mb=4000,
        runtime=5,
    localrule: True
    log:
        "logs/assemble_final_bids/sub-{subject}_ses-{session}.log",
    shell:
        "cp -RL {input.bids_subj_dir} {output.bids_subj_dir} &> {log}"


rule validate_final:
    """final validation before copying, fails if invalid"""
    input:
        bids_dir=stage_for_assembly / "bids",
    output:
        validator_txt=stage_for_assembly / "qc/final_bids_validator.txt",  # require validated
    threads: 1
    resources:
        mem_mb=4000,
        runtime=10,
    shell:
        "bids-validator-deno {input.bids_dir} --format text &> {output.validator_txt}"


if use_gradcorrect:

    rule validate_final_uncorr:
        """final validation before copying, fails if invalid"""
        input:
            bids_dir=stage_fix / "bids",
        output:
            validator_txt=stage_fix / "qc/final_bids_validator.txt",  # require validated
        threads: 1
        resources:
            mem_mb=4000,
            runtime=10,
        shell:
            "bids-validator-deno {input.bids_dir} --format text &> {output.validator_txt}"


rule copy_final_bids_top_level_files:
    """
    Copy top-level BIDS files (dataset_description.json, .bidsignore) to final BIDS directory.
    These are tracked separately from session directories to allow incremental updates.
    """
    input:
        validator_txt=stage_for_assembly / "qc/final_bids_validator.txt",  # require validated
        src_file=stage_for_assembly / "bids-staging/{filename}",
    output:
        dst_file=final_bids_dir / "{filename}",
    wildcard_constraints:
        filename="dataset_description.json|.bidsignore",
    threads: 1
    resources:
        mem_mb=4000,
        runtime=1,
    localrule: True
    log:
        "logs/assemble_final_bids/copy_{filename}.log",
    shell:
        "cp {input.src_file} {output.dst_file} &> {log}"


rule assemble_final_bids_uncorr:
    """
    Assemble the uncorrected BIDS dataset from the fix stage.
    Only used when gradcorrect is enabled and create_bids_uncorr is true in the config.
    This provides the raw (non-resampled) data alongside the gradient-corrected dataset,
    which is useful because the gradcorrect BIDS dataset has been resampled and may be
    missing certain series (e.g. any series with online distortion correction are dropped).
    """
    input:
        validator_txt=stage_fix / "qc/final_bids_validator.txt",  # require validated
        bids_subj_dir=stage_fix / "bids-staging/sub-{subject}/ses-{session}",
    output:
        bids_subj_dir=directory(final_bids_uncorr_dir / "sub-{subject}/ses-{session}"),
    threads: 1
    resources:
        mem_mb=4000,
        runtime=5,
    localrule: True
    log:
        "logs/assemble_final_bids_uncorr/sub-{subject}_ses-{session}.log",
    shell:
        "cp -RL {input.bids_subj_dir} {output.bids_subj_dir} &> {log}"


rule copy_final_bids_uncorr_top_level_files:
    """
    Copy top-level BIDS files (dataset_description.json, .bidsignore) to the uncorrected
    BIDS directory. Only used when gradcorrect is enabled and create_bids_uncorr is true.
    """
    input:
        validator_txt=stage_fix / "qc/final_bids_validator.txt",  # require validated
        src_file=stage_fix / "bids-staging/{filename}",
    output:
        dst_file=final_bids_uncorr_dir / "{filename}",
    wildcard_constraints:
        filename="dataset_description.json|.bidsignore",
    threads: 1
    resources:
        mem_mb=4000,
        runtime=1,
    localrule: True
    log:
        "logs/assemble_final_bids_uncorr/copy_{filename}.log",
    shell:
        "cp {input.src_file} {output.dst_file} &> {log}"


rule clean:
    """
    Clean the final BIDS directory by removing files that are not part of the current dataset.
    This rule finds extraneous files (mainly sub-*/ses-* directories) that should not be present
    and removes them, keeping the directory clean when subjects/sessions are removed from the dataset.
    """
    input:
        session_dirs=expand(
            final_bids_dir / "sub-{subject}/ses-{session}",
            zip,
            subject=subjects,
            session=sessions,
        ),
        dataset_description=final_bids_dir / "dataset_description.json",
        bidsignore=final_bids_dir / ".bidsignore",
    output:
        clean_marker=touch(final_bids_dir / ".clean_marker"),
    threads: 1
    resources:
        mem_mb=4000,
        runtime=10,
    log:
        "logs/clean_final_bids/clean.log",
    script:
        "scripts/clean_final_bids.py"


rule clean_uncorr:
    """
    Clean the final uncorrected BIDS directory by removing files that are not part of the current dataset.
    This rule finds extraneous files (mainly sub-*/ses-* directories) that should not be present
    and removes them, keeping the directory clean when subjects/sessions are removed from the dataset.
    """
    input:
        session_dirs=expand(
            final_bids_uncorr_dir / "sub-{subject}/ses-{session}",
            zip,
            subject=subjects,
            session=sessions,
        ),
        dataset_description=final_bids_uncorr_dir / "dataset_description.json",
        bidsignore=final_bids_uncorr_dir / ".bidsignore",
    output:
        clean_marker=touch(final_bids_uncorr_dir / ".clean_marker"),
    threads: 1
    resources:
        mem_mb=4000,
        runtime=10,
    log:
        "logs/clean_final_uncorr_bids/clean.log",
    script:
        "scripts/clean_final_bids.py"


if "spim" in config and config.get("link_to_spim", False):

    ruleorder: link_spim > assemble_final_bids

    rule link_spim:
        input:
            spim_zarr=lambda wildcards: config["spim"][wildcards.session]["inputs"][
                "ome_zarr"
            ].path,
            spim_json=lambda wildcards: config["spim"][wildcards.session]["inputs"][
                "json"
            ].path,
        params:
            out_zarr=lambda wildcards, output: Path(output.bids_subj_dir)
            / (
                config["spim"][wildcards.session]["out_path"].format(**wildcards)
                + ".ome.zarr"
            ),
            out_json=lambda wildcards, output: Path(output.bids_subj_dir)
            / (
                config["spim"][wildcards.session]["out_path"].format(**wildcards)
                + ".json"
            ),
        output:
            bids_subj_dir=directory(final_bids_dir / "sub-{subject}" / "ses-{session}"),
        wildcard_constraints:
            session="|".join(config["spim"].keys()),
        threads: 1
        localrule: True
        log:
            "logs/link_spim/sub-{subject}_ses-{session}.log",
        shell:
            "mkdir -p {output.bids_subj_dir}/micr && "
            "ln -s {input.spim_zarr} {params.out_zarr} && "
            "ln -s {input.spim_json} {params.out_json} "
