rule gradcorrect:
    """
    Apply gradient nonlinearity correction using the gradcorrect BIDS app.
    Runs per-subject/session using the fixed BIDS staging data as input.
    Only used when gradcorrect is enabled in the config (gradcorrect.enable: true).
    Requires Singularity/Apptainer to run the container.
    A dummy input BIDS directory (bids_in) is created in the cwd with only the
    subject's data symlinked, so the app processes only one subject at a time.
    Output is written to a dummy output dir (bids_out) in the cwd, then the
    subject/session folder is moved to the final output path.
    """
    input:
        bids_subj_dir=stage_fix / "bids-staging/sub-{subject}/ses-{session}",
        dataset_description=stage_fix / "bids-staging/dataset_description.json",
        bidsignore=stage_fix / "bids-staging/.bidsignore",
    output:
        bids_subj_dir=directory(
            stage_gradcorr / "bids-staging/sub-{subject}/ses-{session}"
        ),
    params:
        grad_coeff_file=gradcorrect_config.get("grad_coeff_file"),
    log:
        "logs/gradcorrect/sub-{subject}_ses-{session}.log",
    threads: 2
    resources:
        mem_mb=40000,
        runtime=240,
    container:
        "docker://khanlab/gradcorrect:v0.1.0"
    shadow:
        "minimal"
    shell:
        "mkdir -p bids_in/sub-{wildcards.subject} &> {log} && "
        "ln -sr {input.dataset_description} bids_in/ &>> {log} && "
        "ln -sr {input.bidsignore} bids_in/ &>> {log} && "
        "ln -sr {input.bids_subj_dir} "
        "bids_in/sub-{wildcards.subject}/ses-{wildcards.session} &>> {log} && "
        "run.sh bids_in bids_out participant "
        "--grad_coeff_file {params.grad_coeff_file} &>> {log} && "
        "mkdir -p $(dirname {output.bids_subj_dir}) &>> {log} && "
        "mv bids_out/sub-{wildcards.subject}/ses-{wildcards.session} "
        "{output.bids_subj_dir} &>> {log}"


