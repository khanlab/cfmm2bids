from pathlib import Path

import pandas as pd

from lib.query_filter import (
    compute_query_hash,
    post_filter,
    query_combined,
    query_dicoms,
    should_skip_query,
    validate_column,
)


configfile: "config/config.yml"


# Load stages dict
stages = config.get("stages", {})

stage_query = Path(stages.get("query", "results/0_query"))
stage_filter = Path(stages.get("filter", "results/1_filter"))
stage_download = Path(stages.get("download", "results/2_download"))
stage_convert = Path(stages.get("convert", "results/3_convert"))
stage_fix = Path(stages.get("fix", "results/4_fix"))

final_bids_dir = Path(config.get("final_bids_dir", "bids"))

# ----------
# 0 - query
# ----------
# Paths for query output and hash file
query_tsv_path = stage_query / "studies.tsv"
query_hash_path = stage_query / "query_hash.txt"

# Compute current hash of query parameters
current_query_hash = compute_query_hash(
    config["search_specs"], config.get("query_kwargs", {})
)

# Check if we can skip the query
force_requery = config.get("force_requery", False)
skip_query = should_skip_query(
    query_tsv_path, query_hash_path, current_query_hash, force_requery
)

if skip_query:
    # Try to load existing query results; fall back to re-querying on error
    try:
        df = pd.read_csv(
            query_tsv_path, sep="\t", dtype={"subject": str, "session": str}
        )
    except (pd.errors.ParserError, pd.errors.EmptyDataError, OSError):
        # Fall back to re-querying if cached file is corrupted or unreadable
        skip_query = False

if not skip_query:
    # Perform new query (combined DICOM and filesystem)
    df = query_combined(
        config["search_specs"],
        base_path=Path.cwd(),
        credentials_file=config.get("credentials_file"),
        **config.get("query_kwargs", dict()),
    )

    # save unfiltered list and hash
    stage_query.mkdir(parents=True, exist_ok=True)
    df.to_csv(query_tsv_path, sep="\t", index=False)
    query_hash_path.write_text(current_query_hash)

# Validate both columns
valid_subject = validate_column(df, "subject")
valid_session = validate_column(df, "session")

# ----------
# 1 - filter
# ----------
df = post_filter(df, config["study_filter_specs"]).sort_values(
    by=["subject", "session"]
)


# use --config subject= to process particular subject
if config.get("subject", False):
    df = df[df.subject == str(config["subject"])]

# use --config subject= to process particular subject
if config.get("session", False):
    df = df[df.session == str(config["session"])]

# use --config head=1  to only process first subject
head_n = config.get("head", 0)
if head_n > 0:
    df = df.head(head_n)


# write this out so user can inspect
stage_filter.mkdir(parents=True, exist_ok=True)
df.to_csv(stage_filter / "studies_filtered.tsv", sep="\t", index=False)

# lists for target rules (duplicates dropped)
subjects = df[["subject", "session"]].drop_duplicates().subject
sessions = df[["subject", "session"]].drop_duplicates().session


