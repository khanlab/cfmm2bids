def get_uid_from_wildcards(wildcards):
    matches = lookup(
        query=f"subject == '{wildcards.subject}' and session == '{wildcards.session}'",
        within=df,
    )
    if isinstance(matches, tuple):
        return f"-u {matches.StudyInstanceUID}"
    else:
        ids = [m.StudyInstanceUID for m in matches]
        if config["merge_duplicate_studies"]:
            print(f"WARNING: Merging multiple matches for {wildcards}")
            return " ".join([f"-u {i}" for i in ids])
        else:
            bad_ids = "\n".join(ids)
            raise LookupError(
                f'Multiple studies matched for {wildcards}: \n{bad_ids}\nThese can be merged instead by using setting in the config "merge_duplicate_studies: true" '
            )


def get_source_from_wildcards(wildcards):
    """Get the data source (dicom or filesystem) for a subject/session."""
    matches = lookup(
        query=f"subject == '{wildcards.subject}' and session == '{wildcards.session}'",
        within=df,
    )
    if isinstance(matches, tuple):
        return matches.source
    else:
        # Get first match's source (all should be the same)
        return matches[0].source


def get_fs_path_from_wildcards(wildcards):
    """Get the filesystem path for a subject/session from filesystem query."""
    matches = lookup(
        query=f"subject == '{wildcards.subject}' and session == '{wildcards.session}'",
        within=df,
    )
    if isinstance(matches, tuple):
        return matches.path if hasattr(matches, "path") else None
    else:
        # Return first match's path if it exists
        return matches[0].path if hasattr(matches[0], "path") else None


rule download_data:
    """
    Download or copy DICOM data based on source type.
    
    For DICOM server sources: uses cfmm2tar to download from CFMM
    For filesystem sources: extracts tar files or copies folder contents
    """
    params:
        uid=lambda wildcards: (
            get_uid_from_wildcards(wildcards)
            if get_source_from_wildcards(wildcards) == "dicom"
            else ""
        ),
        fs_path=lambda wildcards: (
            get_fs_path_from_wildcards(wildcards)
            if get_source_from_wildcards(wildcards) == "filesystem"
            else ""
        ),
        source=get_source_from_wildcards,
        cfmm2tar_download_options=config.get("cfmm2tar_download_options", ""),
        creds_file=config.get("credentials_file", ""),
    output:
        dicoms_dir=directory(stage_download / "dicoms/sub-{subject}/ses-{session}"),
    log:
        "logs/download/sub-{subject}_ses-{session}.log",
    threads: 1
    resources:
        mem_mb=4000,
        runtime=15,
    run:
        if params.source == "dicom":
            # Download from DICOM server using cfmm2tar
            shell(
                "cfmm2tar -c {params.creds_file} {params.cfmm2tar_download_options} {params.uid} {output.dicoms_dir} &> {log}"
            )
        elif params.source == "filesystem":
            # Copy or extract from filesystem
            shell(
                """
                mkdir -p {output.dicoms_dir} &> {log}
                
                # Check if source is a tar file
                if [[ "{params.fs_path}" == *.tar.gz ]] || [[ "{params.fs_path}" == *.tar ]]; then
                    # Extract tar file to output directory
                    echo "Extracting tar file: {params.fs_path}" &>> {log}
                    tar -xf {params.fs_path} -C {output.dicoms_dir} &>> {log}
                elif [[ -d "{params.fs_path}" ]]; then
                    # Copy folder contents to output directory
                    echo "Copying folder contents: {params.fs_path}" &>> {log}
                    cp -r {params.fs_path}/* {output.dicoms_dir}/ &>> {log}
                else
                    echo "Error: Unknown file type for {params.fs_path}" &>> {log}
                    exit 1
                fi
                """
            )
        else:
            raise ValueError(f"Unknown source type: {params.source}")


# Keep cfmm2tar as an alias for backwards compatibility
# Note: This rule now handles both DICOM and filesystem sources via download_data
use rule download_data as cfmm2tar


rule heudiconv:
    """
    Run heudiconv to convert DICOMs to BIDS format.
    
    Automatically handles both single-study and multi-study cases:
    - Single study: runs heudiconv directly on the DICOM directory
    - Multiple studies (when merge_duplicate_studies=true): processes each tar file
      separately with heudiconv, then merges outputs with series ID offsetting
    """
    input:
        dicoms_dir=stage_download / "dicoms/sub-{subject}/ses-{session}",
        heuristic=config["heuristic"],
        base_heuristics=config.get("base_heuristics", []),
        dcmconfig_json=config["dcmconfig_json"],
    params:
        heudiconv_options=config["heudiconv_options"],
        out_info_dir=lambda wildcards: stage_convert
        / "qc/sub-{subject}/ses-{session}".format(**wildcards),
    output:
        bids_subj_dir=directory(
            stage_convert / "bids-staging/sub-{subject}/ses-{session}"
        ),
        auto_txt=stage_convert
        / "qc/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_auto.txt",
        dicominfo_tsv=stage_convert
        / "qc/sub-{subject}/ses-{session}/sub-{subject}_ses-{session}_dicominfo.tsv",
    log:
        "logs/heudiconv/sub-{subject}_ses-{session}.log",
    shadow:
        "minimal"
    threads: 16
    resources:
        mem_mb=16000,
        runtime=60,
    script:
        "scripts/run_heudiconv.py"


